# -----------------------------------------------------------------------
# Local development .env — DO NOT COMMIT THIS FILE (add it to .gitignore)
# Fields with no default in Settings are REQUIRED; app won't start without them.
# -----------------------------------------------------------------------

# --- app --------------------------------------------------------------
APP__NAME=my-fastapi-app
APP__ENV=development
APP__DEBUG=true
APP__LOG_LEVEL=DEBUG
APP__CORS_ORIGINS=["http://localhost:3000"]

# --- database (REQUIRED: password) -------------------------------------
DATABASE__HOST=localhost
DATABASE__PORT=5432
DATABASE__USER=postgres
DATABASE__NAME=app
DATABASE__PASSWORD=devpassword123
DATABASE__POOL_SIZE=5
DATABASE__ECHO=false

# --- redis --------------------------------------------------------------
REDIS__URL=redis://localhost:6379/0
# REDIS__PASSWORD=

# --- jwt (REQUIRED: secret_key) ------------------------------------------
JWT__SECRET_KEY=change-me-to-a-random-64-char-string-in-dev
JWT__ALGORITHM=HS256
JWT__ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT__REFRESH_TOKEN_EXPIRE_DAYS=7

# --- third_party (REQUIRED: stripe_api_key, sendgrid_api_key) -----------
THIRD_PARTY__STRIPE_API_KEY=sk_test_placeholder
THIRD_PARTY__SENDGRID_API_KEY=SG.placeholder
THIRD_PARTY__WEBHOOK_BASE_URL=http://localhost:8000/webhooks